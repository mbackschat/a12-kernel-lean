             }
            }
           }
          },
          {
           "type": "Field",
           "id": "/Form/Claims/Amount",
           "name": "Amount",
           "Field": {
            "fieldType": {
             "type": "NumberType",
             "NumberType": {
              "maxFractionalDigits": 2,
              "minFractionalDigits": 2
             }
            }
           }
          }
         ]
        }
       },
       {
        "type": "Rule",
        "id": "/Form/ysf",
        "name": "ysf",
        "Rule": {
         "errorEntityRelPath": "../Holder",
         "errorCode": "ysf",
         "errorCondition": "FieldFilled(Holder) And Sum(Claims*/Amount Having ([Claims/Year] == BaseYear)) > 100",
         "severity": "ERROR",
         "errorMessage": [
          {
           "locale": "en_US",
           "text": "ysf"
          }
         ]
        }
       },
