        "type": "Rule",
        "id": "/Form/ytf",
        "name": "ytf",
        "Rule": {
         "errorEntityRelPath": "../Holder",
         "errorCode": "ytf",
         "errorCondition": "FieldFilled(Holder) And SumOfTerms(Claims* Having [Claims/Year] == BaseYear, [Claims/Amount]) > 100",
         "severity": "ERROR",
         "errorMessage": [
          {
           "locale": "en_US",
           "text": "ytf"
          }
         ]
        }
       },
       {
        "type": "Rule",
        "id": "/Form/ytt",
        "name": "ytt",
        "Rule": {
         "errorEntityRelPath": "../Holder",
         "errorCode": "ytt",
         "errorCondition": "FieldFilled(Holder) And SumOfTerms(Claims*, BaseYear - [Claims/Year]) == 1",
         "severity": "ERROR",
         "errorMessage": [
          {
           "locale": "en_US",
           "text": "ytt"
          }
         ]
        }
       },
       {
        "type": "Rule",
        "id": "/Form/ycn",
        "name": "ycn",
        "Rule": {
         "errorEntityRelPath": "../Holder",
         "errorCode": "ycn",
         "errorCondition": "FieldFilled(Holder) And NumberOfFilledFields(Claims*/Amount Having ([Claims/Year] == BaseYear)) == 2",
         "severity": "ERROR",
         "errorMessage": [
          {
           "locale": "en_US",
           "text": "ycn"
          }
         ]
        }
       },
       {
        "type": "Computation",
        "id": "/Form/yc",
        "name": "yc",
        "Computation": {
         "computedFieldRelPath": "../Total",
         "computationAlternatives": [
          {
           "operation": "SumOfTerms(Claims* Having [Claims/Year] == BaseYear, [Claims/Amount])"
          }
         ],
         "errorMessage": [
          {
           "locale": "en_US",
           "text": "yc"
          }
         ]
        }
       },
       {
        "type": "Computation",
        "id": "/Form/yd",
        "name": "yd",
        "Computation": {
         "computedFieldRelPath": "../Diff",
         "computationAlternatives": [
          {
           "operation": "SumOfTerms(Claims*, BaseYear - [Claims/Year])"
          }
         ],
         "errorMessage": [
          {
           "locale": "en_US",
           "text": "yd"
