   "--code",
   "E2"
  ]
 },
 {
  "id": "min-star-cross",
  "verb": "rule",
  "args": [
   "check",
   "--field",
   "/Xg/CmpYm",
   "--condition",
   "FieldFilled(CmpYm) And MinValue(Rows*/YmDash, Rows*/YmCompact) == [CmpYm]",
   "--code",
   "E3"
  ]
 },
 {
  "id": "min-group-cross",
  "verb": "rule",
  "args": [
