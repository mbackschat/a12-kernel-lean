   "/Xg/CmpYm",
   "--condition",
   "FieldFilled(CmpYm) And MinValue(Blk) == [CmpYm]",
   "--code",
   "E4"
  ]
 },
 {
  "id": "unique-dotted-compact",
  "verb": "rule",
  "args": [
   "check",
   "--field",
   "/Xg/CmpDate",
   "--condition",
   "FieldFilled(CmpDate) And FieldValuesNotUnique(Dotted, Compact)",
   "--code",
   "E5"
  ]
