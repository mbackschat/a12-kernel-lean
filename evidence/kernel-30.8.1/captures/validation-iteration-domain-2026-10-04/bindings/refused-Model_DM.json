  },
  "content": {
    "modelInfo": {
      "name": "Iteration_single-2",
      "variant": "cockpit",
      "revision": "Arbeitsversion",
      "immutable": false
    },
    "modelConfig": {
      "decimalSeparator": ".",
      "timeZone": "UTC",
      "conditionLanguage": {
        "code": "en_US"
      },
      "fieldRefByShortNameAllowed": true
    },
    "modelRoot": {
      "rootGroups": [
        {
          "type": "Group",
          "id": "/Form",
          "name": "Form",
          "Group": {
            "repeatability": 1,
            "elements": [
              {
                "type": "Field",
                "id": "/Form/Qty",
                "name": "Qty",
                "Field": {
                  "fieldType": {
                    "type": "NumberType",
                    "NumberType": {
                      "maxFractionalDigits": 0,
                      "positivesOnly": false
                    }
                  }
                }
              },
              {
                "type": "Group",
                "id": "/Form/Rows",
                "name": "Rows",
                "Group": {
                  "repeatability": 3,
                  "elements": [
                    {
                      "type": "Field",
                      "id": "/Form/Rows/Qty",
                      "name": "Qty",
                      "Field": {
                        "fieldType": {
                          "type": "NumberType",
                          "NumberType": {
                            "maxFractionalDigits": 0,
                            "positivesOnly": false
                          }
                        }
                      }
                    },
                    {
                      "type": "Field",
                      "id": "/Form/Rows/Key",
                      "name": "Key",
                      "Field": {
                        "fieldType": {
                          "type": "StringType",
                          "StringType": {
                            "maxLength": 20
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "/Form/Both",
                "name": "Both",
                "Rule": {
                  "errorEntityRelPath": "../Rows/Qty",
                  "errorCode": "Both",
                  "errorCondition": "AllFieldsFilled(Rows/Qty, Rows/Key)",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en_US",
                      "text": "Iteration check."
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "/Form/Other",
                "name": "Other",
                "Rule": {
                  "errorEntityRelPath": "../Rows/Qty",
                  "errorCode": "Other",
                  "errorCondition": "AtLeastOneFieldFilled(Rows*/Qty Having CurrentRepetition(Rows) != CurrentRepetition($Rows))",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en_US",
                      "text": "Iteration check."
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "/Form/Max",
                "name": "Max",
                "Rule": {
                  "errorEntityRelPath": "../Rows/Qty",
                  "errorCode": "Max",
                  "errorCondition": "MaxValue(Rows/Qty, Rows*/Qty Having CurrentRepetition(Rows) == 1) > 5",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en_US",
                      "text": "Iteration check."
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
