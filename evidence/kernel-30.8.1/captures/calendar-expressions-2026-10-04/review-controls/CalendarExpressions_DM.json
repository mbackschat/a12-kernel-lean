                "name": "NumberConsumer",
                "Computation": {
                  "computedFieldRelPath": "../NOut",
                  "computationAlternatives": [
                    {
                      "operation": "7",
                      "precondition": "Date(\"01\",\"01\",Y) == \"01.01.2024\""
