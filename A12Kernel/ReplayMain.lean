/-! # A12Kernel.ReplayMain — replay retained `kernelProbe` requests through Lean

Each argument is a `kernelProbe` request file. The process reads its model and its Kernel artifact
(`artifact<suffix>.json` beside `req<suffix>.json` or `request<suffix>.json`, the suffix led by `-` or `.`), then for every document
row replays every authored rule and every computation's generated rule, then every computation, and
prints one tab-separated line per instance:

`request  row  rule  code  tier  construct  detail`

A rule whose messages match also prints a line with the code `references`, comparing those messages'
`referenced` and `fillToFix` pointer sets. A row naming a relevant set prints one more line per rule
with the code `partial`, comparing the partial call's messages under that set.
After its computations a row with a retained operand-error channel prints one `call` line with the
code `operands`, comparing that channel as pointer and code sets.

where `tier` is `match`, `tier1` (Lean fires a different message set), `unattributed` (a computation
sharing a refused computation's target or reading one, directly or through other computations, whose outcome is
therefore not attributable to it, agreeing or not), `tier2` (Lean cannot represent the
rule, the computation, the model or the document), `fault` (Lean admitted the rule or plan but
failed running it), or `absent` (no comparable Kernel observation: none retained, an unreadable
artifact or model file, or engines that disagree). A request with no artifact reads its full and
partial messages from a retained `code-field-type` table beside it, when one exists, and replays its
computations against a retained outcome table beside it, when one names the row; a row only an
outcome table names has `absent` rules, since that table keeps no complete message list. A row whose document or model cannot be read
prints one line with the rule column `-`. The Kernel's first engine is the reference.

A rule or computation reading `Today` or `Now` is refused when the request pins no clock, since the
Kernel then read the real one. Dates resolve in the model zone through `ModelZone.concreteRules`.
-/

namespace A12Kernel.Replay

open Lean A12Kernel.Dm

private def readJson (path : System.FilePath) : IO Json := do
  match Json.parse (← IO.FS.readFile path) with
  | .ok json => pure json
  | .error message => throw (IO.userError s!"{path}: {message}")

/-- `2026-10-02T00:00:00Z` as epoch milliseconds; any other spelling is not a clock. -/
private def clockMillis? (text : String) : Option Int := do
  let [date, time] := text.splitOn "T" | none
  let [year, month, day] := date.splitOn "-" | none
  let [hour, minute, second] := (time.dropRightWhile (· == 'Z')).splitOn ":" | none
  let (y, m, d) := (← year.toInt?, ← month.toInt?, ← day.toInt?)
  -- Days from the civil date by the proleptic Gregorian era formula.
  let y' := if m ≤ 2 then y - 1 else y
  let era := (if y' ≥ 0 then y' else y' - 399) / 400
  let yoe := y' - era * 400
  let doy := (153 * (if m > 2 then m - 3 else m + 9) + 2) / 5 + d - 1
  let doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
  let days := era * 146097 + doe - 719468
  pure ((days * 86400 + (← hour.toInt?) * 3600 + (← minute.toInt?) * 60 + (← second.toInt?)) * 1000)

/-- The artifact a request produced: its name with `req` or `request` replaced by `artifact`, the
suffix after the first `-` or `.` kept. -/
private def artifactPath (requestPath : System.FilePath) : System.FilePath :=
  let stem := requestPath.fileStem.getD ""
  let suffix := (stem.dropWhile Char.isAlpha).toString
  (requestPath.parent.getD ".") / s!"artifact{suffix}.json"

/-- The computation outcomes a capture retained as a table rather than an artifact, by row name:
every `.tsv` beside the request headed `# row field outcome value`, or `# run row field outcome value`
with the run naming this request's suffix. Formal, operand-error and message lines are no outcomes and
are skipped. Every named row is listed, even one with no outcome line. -/
private def tableOutcomes (requestPath : System.FilePath) :
    IO (List String × List (String × ComputedOutcome)) := do
  let directory := requestPath.parent.getD "."
  let run := (((requestPath.fileStem.getD "").dropWhile Char.isAlpha).dropWhile
    (fun c => c == '-' || c == '.')).toString
  let mut rows : List String := []
  let mut outcomes : List (String × ComputedOutcome) := []
  for entry in ← directory.readDir do
    if entry.path.extension != some "tsv" then continue
    let lines := ((← IO.FS.readFile entry.path).splitOn "\n").filter (· != "")
    let runColumn ← match lines.head? with
      | some "# row\tfield\toutcome\tvalue" => pure false
      | some "# run\trow\tfield\toutcome\tvalue" => pure true
      | _ => continue
    for line in lines.drop 1 do
      let cells := line.splitOn "\t"
      let cells := if runColumn then (if cells.head? == some run then cells.drop 1 else []) else cells
      let row :: pointer :: outcome :: rest := cells | continue
      if !rows.contains row then rows := rows ++ [row]
      let value := rest.headD ""
      let text? := match outcome with
        | "value" => some s!"value {value}"
        | "cleared" => some "cleared"
        | "errored" => some s!"errored {value}"
        | _ => none
      if let some text := text? then outcomes := outcomes ++ [(row, { pointer, outcome := text })]
  pure (rows, outcomes)

/-- The full and partial messages a capture retained as a table rather than an artifact, as artifact
rows: every `.tsv` beside the request headed `# row observation code-field-type`, whose `validateFull`
and `validatePart` lines list each message's code, field and type. Such a row is marked `tabled`,
since the table keeps no reference channels. A channel without its line stays absent rather than
empty, and a malformed line, an unreadable list or a second line for the same row and channel, from
any table beside the request, fails the request instead of pairing silently. -/
private def tableMessageRows (requestPath : System.FilePath) : IO (Array Json) := do
  let mut rows : Array (String × Option (Array Json) × Option (Array Json)) := #[]
  for entry in ← (requestPath.parent.getD ".").readDir do
    if entry.path.extension != some "tsv" then continue
    let lines := ((← IO.FS.readFile entry.path).splitOn "\n").map (·.dropRightWhile (· == '\r'))
      |>.filter (· != "")
    if lines.head? != some "# row\tobservation\tcode-field-type" then continue
    for line in lines.drop 1 do
      let [row, observation, list] := line.splitOn "\t"
        | throw (IO.userError s!"{entry.path}: malformed table line {line}")
      let some messages := (Json.parse list).toOption.bind (·.getArr?.toOption)
        | throw (IO.userError s!"{entry.path}: unreadable message list for {row}")
      let (full, part) := (rows.find? (·.1 == row)).map (·.2) |>.getD (none, none)
      let updated ← match observation, full, part with
        | "validateFull", none, _ => pure (some messages, part)
        | "validatePart", _, none => pure (full, some messages)
        | _, _, _ => throw (IO.userError s!"{entry.path}: repeated or unknown observation {observation} for {row}")
      rows := (rows.filter (·.1 != row)).push (row, updated)
  pure (rows.map fun (row, full, part) =>
    let channel (key : String) : Option (Array Json) → List (String × Json)
      | some messages => [(key, Json.arr messages)]
      | none => []
    Json.mkObj [("name", Json.str row), ("tabled", true),
      ("engines", Json.arr #[Json.mkObj (channel "messages" full ++ channel "partialMessages" part)])])

/-- The first engine's messages on one channel, `messages` for full validation or `partialMessages`
for the row's partial call. -/
private def kernelMessages (row : Json) (channel : String := "messages") :
    Option (Bool × List ObservedMessage) := do
  let engines ← (row.getObjValAs? (Array Json) "engines").toOption
  let first ← engines[0]?
  let messages ← (first.getObjValAs? (Array Json) channel).toOption
  let agree := (row.getObjValAs? Bool "enginesAgree").toOption.getD true
  pure (agree, messages.toList.filterMap fun message => do
    pure { code := ← (message.getObjValAs? String "code").toOption
           pointer := ← (message.getObjValAs? String "field").toOption
           messageType := ← (message.getObjValAs? String "type").toOption
           severity := (message.getObjValAs? String "severity").toOption.getD "ERROR" })

/-- A row's relevant set in the probe's spelling: a model path, and one repetition per path part
with `0` for every instance, all of them when `reps` is omitted. -/
private def relevantSet (row : Json) : Option (List RelevantEntityPattern) := do
  let entries ← (row.getObjValAs? (Array Json) "relevant").toOption
  entries.toList.mapM fun entry => do
    let path := ((← (entry.getObjValAs? String "path").toOption).splitOn "/").filter (· != "")
    match (entry.getObjValAs? (Array Nat) "reps").toOption with
    | none => pure (RelevantEntityPattern.allInstances path)
    | some reps =>
        if reps.size != path.length then none
        else pure { path, indices := reps.toList.map fun n => if n == 0 then .all else .concrete n }

/-- Each message's reference channels as the first engine reported them. -/
private def kernelReferences (row : Json) : List ObservedReferences := Id.run do
  let some engines := (row.getObjValAs? (Array Json) "engines").toOption | return []
  let some first := engines[0]? | return []
  let some messages := (first.getObjValAs? (Array Json) "messages").toOption | return []
  let pointers (message : Json) (key : String) : List String :=
    ((message.getObjValAs? (Array String) key).toOption.getD #[]).toList
  messages.toList.filterMap fun message => do
    pure { message := { code := ← (message.getObjValAs? String "code").toOption
                        pointer := ← (message.getObjValAs? String "field").toOption
                        messageType := ← (message.getObjValAs? String "type").toOption
                        severity := (message.getObjValAs? String "severity").toOption.getD "ERROR" }
           referenced := pointers message "referenced", fillToFix := pointers message "fillToFix" }

private def kernelComputations (row : Json) : Option (List ComputedOutcome) := do
  let engines ← (row.getObjValAs? (Array Json) "engines").toOption
  let first ← engines[0]?
  let computations ← (first.getObjVal? "computations").toOption
  let outcomes ← (computations.getObjValAs? (Array Json) "outcomes").toOption
  pure (outcomes.toList.filterMap fun outcome => do
    let pointer ← (outcome.getObjValAs? String "field").toOption
    let value := (outcome.getObjValAs? String "value").toOption.getD ""
    let text := if (outcome.getObjValAs? Bool "cleared").toOption == some true then "cleared"
      else if (outcome.getObjValAs? Bool "errored").toOption == some true then s!"errored {value}"
      else s!"value {value}"
    pure { pointer, outcome := text })

/-- The call's formal-error channel as the Kernel reported it, sorted, since order is not compared. -/
private def kernelOperandMessages (row : Json) : Option (List ComputedMessage) := do
  let engines ← (row.getObjValAs? (Array Json) "engines").toOption
  let computations ← (engines[0]?.getD Json.null).getObjVal? "computations" |>.toOption
  let messages ← (computations.getObjValAs? (Array Json) "formalErrorsInOperands").toOption
  -- A message missing either key stays in the oracle as `?`, so it diverges rather than vanishing.
  pure ((messages.toList.map fun message =>
    ({ pointer := (message.getObjValAs? String "field").toOption.getD "?"
       code := (message.getObjValAs? String "code").toOption.getD "?" } : ComputedMessage)).mergeSort
    (compare · · != .gt))

/-- A pointer without its row indices, the target path it addresses. -/
private def unindexed (pointer : String) : String :=
  "/".intercalate ((pointer.splitOn "/").map fun segment => (segment.splitOn "[").head!)

private def sorted (outcomes : List ComputedOutcome) : List ComputedOutcome :=
  outcomes.mergeSort (compare · · != .gt)

/-- Whether a condition or operation text names `Today` or `Now`. -/
private def readsClock (language : Language) (text : String) : Bool :=
  match lex language text with
  | .ok lexemes => lexemes.any fun lexeme => lexeme.token == .keyword "Today" || lexeme.token == .keyword "Now"
  | .error _ => false

private def computationTexts (computation : DmComputation) : List String :=
  computation.commonPrecondition.toList ++ computation.alternatives.flatMap fun alternative =>
    alternative.precondition.toList ++ [alternative.operation]

/-- The names a text reads, by its lexed name tokens. -/
private def namesRead (language : Language) (text : String) : List String :=
  match lex language text with
  | .ok lexemes => lexemes.toList.filterMap fun lexeme => match lexeme.token with
      | .name name => some name
      | _ => none
  | .error _ => []

/-- The names ending a path the text reads, a star after it included: the operand a group read
such as `NumberOfFilledFields(G)` names. -/
private def pathEndsRead (language : Language) (text : String) : List String :=
  let rec ends : List Token → List String
    | .name _ :: .symbol "*" :: .symbol "/" :: rest | .name _ :: .symbol "/" :: rest => ends rest
    | .name name :: rest => name :: ends rest
    | _ :: rest => ends rest
    | [] => []
  match lex language text with
  | .ok lexemes => ends (lexemes.toList.map (·.token))
  | .error _ => []

private def targetName (computation : DmComputation) : String :=
  ((computation.targetRelPath.splitOn "/").getLast?.getD "").dropWhile (· == '.') |>.toString

/-- Replay keys retain declaration scope when a model repeats a local name; otherwise population
comparisons silently merge root and row computations (comparison-guard capture, 2026-10-04). -/
private def replayName (names : List String) (group : GroupPath) (name : String) : String :=
  if (names.filter (· == name)).length > 1 then "/".intercalate (group ++ [name]) else name

example : replayName ["Same", "Same", "Unique"] ["Form"] "Same" = "Form/Same" ∧
    replayName ["Same", "Same", "Unique"] ["Form", "Rows"] "Same" = "Form/Rows/Same" ∧
    replayName ["Same", "Same", "Unique"] ["Form"] "Unique" = "Unique" := by native_decide

/-- Compare every computation of `model` on one checked document against the Kernel's outcomes,
printing one line per computation through `line`, and then the call's formal-error channel against
`kernelMessages?` on a `call` line under the code `operands`. The channel is the whole call's, so a refused
computation leaves it unattributed. -/
private def replayComputations (line : String → String → String → String → IO Unit)
    (clocked : Bool) (model : DmModel) (language : Language) (world : World)
    (prepared : PreparedFlatStringContext model.flat compilePattern)
    (checked : CheckedDocument model.flat) (kernel : List ComputedOutcome)
    (kernelMessages? : Option (List ComputedMessage) := none) : IO Unit := do
  let attempts := model.computations.map fun computation =>
    (computation, if !clocked && (computationTexts computation).any (readsClock language) then
        .error { construct := "Clock", detail := "the request pins no clock" }
      else lowerComputation model.flat language computation)
  for (computation, attempt) in attempts do
    if let .error refusal := attempt then
      line (replayName (model.computations.map (·.name)) computation.group computation.name) "compute" "tier2" s!"{refusal.construct}\t{oneLine refusal.detail}"
  let admitted := attempts.filterMap fun (computation, attempt) =>
    attempt.toOption.map fun (target, lowered) => (computation, target, lowered)
  if admitted.isEmpty then return
  -- A fed target is read by its name, or through a group operand naming one of its groups.
  let groupsOf (computation : DmComputation) : List String :=
    (targetOf language model.flat computation).toOption.map (·.groupPath) |>.getD []
  let reads (fed : List DmComputation) (computation : DmComputation) :=
    (computationTexts computation).any fun text =>
      (namesRead language text).any (fed.map targetName).contains ||
        (pathEndsRead language text).any (fed.flatMap groupsOf).contains
  -- Feeding is transitive: a computation reading a fed one's target reads a value the refused
  -- computation upstream decided, so the closure over reads is taken, one round per computation.
  let refused := attempts.filterMap fun (computation, attempt) =>
    if attempt.toOption.isNone then some computation else none
  let fedTargets := (List.range model.computations.length).foldl (init := refused) fun fed _ =>
    fed ++ model.computations.filter fun computation =>
      !(fed.map targetName).contains (targetName computation) && reads fed computation
  let result : Lowering (List ComputedOutcome × Option (List ComputedMessage)) := if refused.isEmpty then
      (fun (outcomes, messages) => (outcomes, some messages)) <$>
        runModelComputationsWithMessages model language world prepared checked
    else
      (·, none) <$> runComputations world prepared checked (admitted.map (·.2.2))
  match result with
  | .error refusal =>
      -- A plan Lean certified and then failed to run is a fault; an uncertified plan is a refusal.
      let tier := if refusal.construct == "ComputationRun" then "fault" else "tier2"
      for (computation, _, _) in admitted do
        line (replayName (model.computations.map (·.name)) computation.group computation.name) "compute" tier s!"{refusal.construct}\t{oneLine refusal.detail}"
  | .ok (outcomes, messages?) =>
      for (computation, target, _) in admitted do
        let path := "/".intercalate target.path
        let lean := sorted (outcomes.filter (unindexed ·.pointer == path))
        let expected := sorted (kernel.filter (unindexed ·.pointer == path))
        -- Shared targets have incomplete alternative tables; fed readers may instead observe
        -- stored values the Kernel recomputes. Neither agreement nor divergence is attributable
        -- in either case. Shared-target identity is exact; the lexical read closure over-approximates.
        if hasRefusedComputationTarget language model.flat refused target.id ||
            reads fedTargets computation then
          line (replayName (model.computations.map (·.name)) computation.group computation.name) "compute" "unattributed" s!"Fed\tlean={lean} kernel={expected}"
        else if lean == expected then line (replayName (model.computations.map (·.name)) computation.group computation.name) "compute" "match" ""
        else line (replayName (model.computations.map (·.name)) computation.group computation.name) "compute" "tier1" s!"Divergence\tlean={lean} kernel={expected}"
      if let some kernelMessages := kernelMessages? then
        match messages? with
        | none => line "call" "operands" "unattributed" "Fed\ta refused computation leaves the channel incomplete"
        | some lean =>
            if lean == kernelMessages then line "call" "operands" "match" ""
            else line "call" "operands" "tier1" s!"Divergence\tlean={lean} kernel={kernelMessages}"

/-- One concrete cell in A12's `DocumentPointer` spelling, `Form/Rows[2]/Label` with each omitted
repetition `[1]`, as the probe's `whenFilled` names it; a wildcard `[0]` names no cell. -/
private def pointerCell (model : FlatModel) (pointer : String) : Option CellAddr := do
  let parts ← (pointer.splitOn "/").mapM fun segment =>
    match segment.splitOn "[" with
    | [name] => some (name, 1)
    | [name, index] => do
        let n ← (index.dropRightWhile (· == ']')).toNat?
        if n == 0 then none else some (name, n)
    | _ => none
  let names := parts.map (·.1)
  let field ← model.fields.find? fun declaration => declaration.groupPath ++ [declaration.name] == names
  let path ← field.repeatableScope.mapM fun level => do
    let group ← model.repeatableGroups.find? (·.level == level)
    (parts[group.path.length - 1]?).map (·.2)
  pure { field := field.id, path }

/-- The request's declared custom conditions as the host's one factory: `returns` answers a constant,
`whenFilled` whether the named cell holds a stored text, and any other name is unregistered
(a12-dmkits `DeclarativeCustomConditions` at the measurement pin). A placed empty or blank text counts
as filled, since the callback's data view hands it over where only an absent cell reads as none
(k22-static-s6-2026-10-24, `when-filled`); a repeatable cell reads the same way whatever the call's
relevant set (k22-runtime-r7-2026-10-24, `rB`). -/
private def declaredConditions (model : FlatModel) (request : Json) :
    Except String (CustomValidationRegistry model) := do
  let .ok declared := request.getObjVal? "customConditions" | pure {}
  let .obj entries := declared | throw "customConditions is no object"
  let answers ← entries.toList.mapM fun (name, spec) => do
    -- An answer key this replay does not know would otherwise be read as one it does.
    let .obj members := spec | throw s!"{name} is no object"
    if let some key := members.toList.find? (!["returns", "whenFilled"].contains ·.1) then
      throw s!"{name} declares an unknown key {key.1}"
    match spec.getObjValAs? Bool "returns", spec.getObjValAs? String "whenFilled" with
    | .ok value, .error _ => pure (name, fun (_ : CustomValidationInvocation model) => value)
    | .error _, .ok pointer =>
        match pointerCell model pointer with
        | some cell => pure (name, fun (input : CustomValidationInvocation model) =>
            (input.data.storedTextAt cell).isSome)
        | none => throw s!"whenFilled {pointer} names no cell"
    | _, _ => throw s!"{name} must declare exactly one of returns and whenFilled"
  pure { configured := some fun name => (answers.find? (·.1 == name)).map (·.2) }

private def replayRequest (requestPath : System.FilePath) : IO Unit := do
  let line (row rule code tier rest : String) :=
    IO.println s!"{requestPath}\t{row}\t{rule}\t{code}\t{tier}\t{rest.replace "\n" " "}"
  let request ← readJson requestPath
  let directory := requestPath.parent.getD "."
  let some modelName := (request.getObjValAs? String "model").toOption
    | line "-" "-" "-" "tier2" "Request\tno model"
  let model ← match (parseModelJson (← IO.FS.readFile (directory / modelName))).bind (readModel ·) with
    | .ok model => pure model
    | .error reason => do line "-" "-" "-" "tier2" s!"Model\t{reason}"; return
  -- A declaration the reader could not map leaves every rule and computation reading it
  -- unrepresented, and a group read cannot be told from one that skips it, so the model is refused.
  if let some (path, reason) := model.refusals.head? then
    line "-" "-" "-" "tier2" s!"Model\t{"/".intercalate path}: {reason}"; return
  let some language := Language.ofCode? model.conditionLanguage
    | line "-" "-" "-" "tier2" s!"Language\t{model.conditionLanguage}"
  let registry ← match declaredConditions model.flat request with
    | .ok registry => pure registry
    | .error reason => do line "-" "-" "-" "tier2" s!"Request\tcustomConditions: {reason}"; return
  let locale ← match Dm.localeKey ((request.getObjValAs? String "locale").toOption.getD "en_US") with
    | .ok locale => pure locale
    | .error reason => do line "-" "-" "-" "tier2" s!"Request\tlocale: {reason}"; return
  let clock? := (request.getObjValAs? String "clock").toOption.bind clockMillis?
  let world : World := { now := { epochMillis := clock?.getD 0 }, modelZoneRules := ModelZone.concreteRules }
  let artifactFile := artifactPath requestPath
  let artifact ← if ← artifactFile.pathExists then
      try pure (some (← readJson artifactFile)) catch error => do
        line "-" "-" "-" "absent" s!"Artifact\tunreadable: {error}"; return
    else pure none
  let artifactRows ← match artifact with
    | some json => pure ((json.getObjValAs? (Array Json) "rows").toOption.getD #[])
    | none =>
        try tableMessageRows requestPath catch error => do
          line "-" "-" "-" "absent" s!"Table\tunreadable: {error}"; return
  let (tabledRows, tabled) ← if artifact.isNone then tableOutcomes requestPath else pure ([], [])
  let prepared ← match prepareFlatStringContext world builtinStringPatternCompiler model.flat with
    | .ok prepared => pure prepared
    | .error error => do line "-" "-" "-" "tier2" s!"Prepare\t{repr error}"; return
  for row in (request.getObjValAs? (Array Json) "rows").toOption.getD #[] do
    let name := (row.getObjValAs? String "name").toOption.getD "?"
    let observedRow := artifactRows.find? fun observed =>
      (observed.getObjValAs? String "name").toOption == some name
    let observed := observedRow.bind kernelMessages
    let table := if tabledRows.contains name then
        some (tabled.filterMap fun (row, outcome) => if row == name then some outcome else none)
      else none
    if observed.isNone && table.isNone then
      line name "-" "-" "absent" "Artifact\tno retained observation"; continue
    if let some (false, _) := observed then
      line name "-" "-" "absent" "Engines\tthe Kernel's engines disagree"; continue
    let document ← match row.getObjVal? "documentInline", row.getObjValAs? String "document" with
      | .ok inline, _ => pure inline
      | _, .ok file =>
          match parseDocumentJson (← IO.FS.readFile (directory / file)) with
          | .ok json => pure json
          | .error reason => do line name "-" "-" "tier2" s!"Document\t{reason}"; continue
      | _, _ => do line name "-" "-" "tier2" "Request\tno document"; continue
    match readDocument model document with
    | .error reason => line name "-" "-" "tier2" s!"Document\t{reason}"
    | .ok read =>
        if let some (path, reason) := read.refusals.head? then
          line name "-" "-" "tier2" s!"Document\t{"/".intercalate path}: {reason}"
          continue
        match checkDocument prepared locale read.data with
        | .error error => line name "-" "-" "tier2" s!"Document\t{(repr error).pretty 200}"
        | .ok checked =>
            let references := observedRow.map kernelReferences |>.getD []
            -- A table records no complete message list, so its rows leave the rules unobserved.
            let some (_, kernel) := observed
              | do
                  line name "-" "-" "absent" "Table\tthe retained table holds computation outcomes only"
                  if let some computed := table then
                    replayComputations (line name) clock?.isSome model language world prepared checked computed
            for verdict in replayRules model language world checked kernel references (some (prepared, locale)) registry do
              let ruleName := replayName (model.rules.map (·.name)) verdict.rule.group verdict.rule.name
              if clock?.isNone && readsClock language verdict.rule.condition then
                line name ruleName verdict.rule.errorCode "tier2" "Clock\tthe request pins no clock"
              else
                line name ruleName verdict.rule.errorCode verdict.status.tier verdict.status.detail
                -- The reference channels report under the code `references`, an arm of their own;
                -- a tabled row retains none.
                if let some status := verdict.references.filter fun _ =>
                    (observedRow.bind (·.getObjValAs? Bool "tabled" |>.toOption)) != some true then
                  line name ruleName "references" status.tier status.detail
            -- The partial channel reports under the code `partial`, as the reference channels do.
            if (row.getObjVal? "relevant").toOption.isSome then
              match relevantSet row, observedRow.bind (kernelMessages · "partialMessages") with
              | none, _ => line name "-" "partial" "tier2" "Request\tunreadable relevant set"
              | some _, none => pure ()
              | some relevant, some (_, partialKernel) =>
                  for verdict in replayRulesPartial model language world checked relevant partialKernel registry do
                    let ruleName := replayName (model.rules.map (·.name)) verdict.rule.group verdict.rule.name
                    if !(clock?.isNone && readsClock language verdict.rule.condition) then
                      line name ruleName "partial" verdict.status.tier verdict.status.detail
            if let some computed := observedRow.bind kernelComputations then
              replayComputations (line name) clock?.isSome model language world prepared checked computed
                (observedRow.bind kernelOperandMessages)

end A12Kernel.Replay

def main (arguments : List String) : IO UInt32 := do
  for argument in arguments do
    try A12Kernel.Replay.replayRequest argument
    catch error => IO.println s!"{argument}\t-\t-\t-\tabsent\tIO\t{(toString error).replace "\n" " "}"
  pure 0
